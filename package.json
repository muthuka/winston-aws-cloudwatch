{
  "name": "@muthu16/winston-aws-cloudwatch",
  "version": "3.1.3",
  "description": "A Winston transport for Amazon CloudWatch.",
  "keywords": [
    "amazon",
    "aws",
    "cloudwatch",
    "winston",
    "log",
    "logs",
    "logging",
    "cloud",
    "saas"
  ],
  "author": "Tim De Pauw <hi@tmdpw.eu> (https://tmdpw.eu/)",
  "engines": {
    "node": ">=20",
    "yarn": ">=1.6.0"
  },
  "peerDependencies": {
    "winston": "^3.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1128.0",
    "bottleneck": "^2.19.5",
    "debug": "^4.4.3",
    "lodash.isempty": "^4.4.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "delay": "^7.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "mocha": "^12.0.0",
    "mocha-junit-reporter": "^2.2.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "standard": "^17.1.2"
  },
  "main": "lib/index.js",
  "files": [
    "lib/"
  ],
  "scripts": {
    "test": "npm run test:lint && npm run test:cover",
    "test:lint": "standard '{lib,test}/**/*.js'",
    "test:unit": "mocha 'test/lib/setup.js' 'test/**/*.spec.js'",
    "test:cover": "c8 npm run test:unit",
    "test:ci": "npm run test:lint && npm run test:ci:cover",
    "test:ci:cover": "c8 mocha --reporter mocha-junit-reporter 'test/lib/setup.js' 'test/**/*.spec.js'",
    "format": "prettier --write '{lib,test}/**/*.js'",
    "precommit": "lint-staged"
  },
  "repository": "muthuka/winston-aws-cloudwatch",
  "bugs": "https://github.com/muthuka/winston-aws-cloudwatch/issues",
  "license": "MIT",
  "standard": {
    "globals": [
      "describe",
      "it",
      "expect",
      "before",
      "after",
      "beforeEach",
      "afterEach",
      "sinon"
    ]
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ]
  }
}
